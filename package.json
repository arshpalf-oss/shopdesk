{
  "name": "shopdesk",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "shopdesk — Cloud inventory, billing & POS for every business. Sign up, open your counter from anywhere: GST invoices, live stock, udhaar khata, reports. Self-host on Vercel + MongoDB Atlas.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node scripts/seed-demo.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "canvas-confetti": "1.9.3",
    "express": "5.3.0",
    "framer-motion": "11.18.2",
    "lucide-react": "1.61.0",
    "mongoose": "^8.24.11",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.6.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^31.0.1",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
